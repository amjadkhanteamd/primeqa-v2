# Live integration test database — optional override of DATABASE_URL
# specifically for tests under tests/integration/. Defaults to
# DATABASE_URL when unset.
#
# Use a local Postgres URL for reliable long-running tests:
#   LIVE_DATABASE_URL=postgresql://<user>@localhost:5432/primeqa_local
#
# Railway's public TCP proxy (switchback.proxy.rlwy.net) exhibits
# intermittent layer-7 connection termination on the multi-minute
# sync test suite, which is why live tests prefer a local Postgres.
# DATABASE_URL can stay pointed at Railway for ad-hoc tooling.
LIVE_DATABASE_URL=

# Embedding API — Voyage AI (per D-049). The §23 enrichment worker
# calls the Voyage embeddings API (model voyage-3, 1024-dim) to
# populate entities.embedding + detail-table summary embeddings.
# Read by primeqa/intelligence/embeddings.py. Required for the
# enrichment worker + tests/integration/test_live_enrichment.py.
VOYAGE_API_KEY=your_voyage_api_key_here
