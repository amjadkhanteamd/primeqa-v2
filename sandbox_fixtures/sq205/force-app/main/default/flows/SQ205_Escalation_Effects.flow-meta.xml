<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>SQ-205 AC3+AC4: when an Escalation__c is created, move the parent Case to Status=Escalated and stamp the linked Account's Last_Escalation_Date__c with today. (Uses the org's existing standard 'Escalated' status — the requirement's 'In Escalation' label maps onto it.)</description>
    <interviewLabel>SQ205 Escalation Effects {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SQ205 Escalation Effects</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Parent_Case</name>
        <label>Update Parent Case</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <connector><targetReference>Stamp_Account</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Case__c</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Escalated</stringValue></value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>Stamp_Account</name>
        <label>Stamp Account</label>
        <locationX>176</locationX>
        <locationY>407</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Account__c</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Last_Escalation_Date__c</field>
            <value><elementReference>$Flow.CurrentDate</elementReference></value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Update_Parent_Case</targetReference></connector>
        <object>Escalation__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
