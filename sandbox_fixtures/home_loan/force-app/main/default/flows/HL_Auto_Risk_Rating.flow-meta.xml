<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>When Opportunity Stage changes to Credit Assessment, auto-calculate Risk Rating based on Credit Score.</description>
    <interviewLabel>HL Auto Risk Rating {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HL Auto Risk Rating</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>

    <decisions>
        <name>Check_Credit_Score</name>
        <label>Check Credit Score</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Set_Risk_High</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Below 650</defaultConnectorLabel>
        <rules>
            <name>Score_750_Plus</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Credit_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue><numberValue>750.0</numberValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Risk_Low</targetReference>
            </connector>
            <label>750+</label>
        </rules>
        <rules>
            <name>Score_650_749</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Credit_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue><numberValue>650.0</numberValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Risk_Medium</targetReference>
            </connector>
            <label>650-749</label>
        </rules>
    </decisions>

    <recordUpdates>
        <name>Set_Risk_Low</name>
        <label>Set Risk Low</label>
        <locationX>50</locationX>
        <locationY>500</locationY>
        <inputAssignments>
            <field>Risk_Rating__c</field>
            <value><stringValue>Low</stringValue></value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>

    <recordUpdates>
        <name>Set_Risk_Medium</name>
        <label>Set Risk Medium</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <inputAssignments>
            <field>Risk_Rating__c</field>
            <value><stringValue>Medium</stringValue></value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>

    <recordUpdates>
        <name>Set_Risk_High</name>
        <label>Set Risk High</label>
        <locationX>302</locationX>
        <locationY>500</locationY>
        <inputAssignments>
            <field>Risk_Rating__c</field>
            <value><stringValue>High</stringValue></value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Credit_Score</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value><stringValue>Credit Assessment</stringValue></value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
