<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <decisions>
        <name>Still_Submitted</name>
        <label>Still Submitted?</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Moved On</defaultConnectorLabel>
        <rules>
            <name>Is_Still_Submitted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_Order.PLS_FB_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Escalated</targetReference>
            </connector>
            <label>Is Still Submitted</label>
        </rules>
    </decisions>
    <description>FB-V1 benchmark FL10. Orders sitting in Submitted too long are escalated: 2 days after an order is updated into Submitted, if it is STILL Submitted (re-checked against the record's current state at execution time), mark it Escalated and create an open Escalation task. Nothing is observable at save time — the effect executes on the scheduled path only.</description>
    <environments>Default</environments>
    <interviewLabel>PLS FB FL10 Stale Order Escalation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PLS FB FL10 Stale Order Escalation</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Escalation_Task</name>
        <label>Create Escalation Task</label>
        <locationX>176</locationX>
        <locationY>527</locationY>
        <inputAssignments>
            <field>PLS_FB_Due_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PLS_FB_Order__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PLS_FB_Status__c</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PLS_FB_Type__c</field>
            <value>
                <stringValue>Escalation</stringValue>
            </value>
        </inputAssignments>
        <object>PLS_FB_Fulfilment_Task__c</object>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Current_Order</name>
        <label>Get Current Order</label>
        <locationX>176</locationX>
        <locationY>167</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Still_Submitted</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PLS_FB_Order__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Mark_Escalated</name>
        <label>Mark Escalated</label>
        <locationX>176</locationX>
        <locationY>407</locationY>
        <connector>
            <targetReference>Create_Escalation_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PLS_FB_Escalated__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>PLS_FB_Order__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PLS_FB_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </filters>
        <object>PLS_FB_Order__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>Two_Days_After_Submitted</name>
            <connector>
                <targetReference>Get_Current_Order</targetReference>
            </connector>
            <label>Two Days After Submitted</label>
            <offsetNumber>2</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
