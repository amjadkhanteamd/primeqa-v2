        <label>Mark Completed</label>
        <locationX>264</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>Loop_Tasks.PLS_FB_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
