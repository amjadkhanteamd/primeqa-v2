<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <assignments>
        <name>Stamp_SLA</name>
        <label>Stamp SLA Deadline</label>
        <locationX>176</locationX>
        <locationY>167</locationY>
        <assignmentItems>
            <assignToReference>$Record.PLS_FB_SLA_Deadline__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fSLADate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>FB-V1 benchmark FL08. Submitting an order stamps the service-level deadline the team must meet: when an order is updated into Submitted status, set SLA Deadline to the submission date plus 5 days, before save. The offset is defined here in the flow, not in any requirement text.</description>
    <environments>Default</environments>
    <formulas>
        <name>fSLADate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 5</expression>
    </formulas>
    <interviewLabel>PLS FB FL08 SLA Stamp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PLS FB FL08 SLA Stamp</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stamp_SLA</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PLS_FB_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </filters>
        <object>PLS_FB_Order__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>50</triggerOrder>
</Flow>
